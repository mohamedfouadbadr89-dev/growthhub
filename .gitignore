# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend (Hono / Railway)
backend/node_modules/
backend/dist/

# supabase
.supabase/

# clerk configuration (can include secrets)
/.clerk/
.claude/

# Python creative runtime (operator-side tooling only — see
# tools/python-creative/README.md). Virtual environments + bytecode +
# packaging artifacts MUST NEVER be committed; the requirements.txt and
# verification script ARE committed.
tools/python-creative/.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
