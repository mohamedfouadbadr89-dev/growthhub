# ─── Startup-mandatory env vars ──────────────────────────────────────
# Backend fail-fasts at boot (process.exit(1)) if ANY of the seven below
# are unset. See backend/src/index.ts:requiredEnvVars and
# backend/src/lib/supabase.ts (module-load throw on Supabase pair).
CLERK_SECRET_KEY=
# Continuation #115 (2026-05-14) — CRITICAL SECURITY REMEDIATION.
# Prior commits to this example file contained a REAL Supabase
# `service_role` JWT inlined as the SUPABASE_SERVICE_ROLE_KEY default
# (decoded ref=lstrkrnkzolcnfkltyjf, role=service_role, exp=2092237771).
# Service-role bypasses RLS — anyone cloning this repo could read/write
# every org's data. The token has been redacted from this file but
# REMAINS IN GIT HISTORY. Required operator remediation:
#   1. Rotate the service_role key in Supabase dashboard → Project
#      Settings → API → "Regenerate service_role key"
#   2. Update production deploy with the new key
#   3. (Optional) `git filter-repo` or BFG to scrub history if the repo
#      is public or has untrusted clones
# The URL below is NOT a secret (Supabase project URLs are public
# endpoints; the protection is the service_role key + RLS), so it's
# left as a real default to ease local-dev wiring.
SUPABASE_URL=https://lstrkrnkzolcnfkltyjf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

OPENROUTER_API_KEY=
INNGEST_EVENT_KEY=
# HMAC secret for signature verification on the public /api/inngest
# endpoint. Without this set, inbound webhook requests skip verification
# (a CONSTITUTION §1.3 violation). Startup-fatal as of 2026-05.
INNGEST_SIGNING_KEY=
# Svix HMAC secret for verifying Clerk webhook deliveries at
# /api/webhooks/clerk. Without this set, the handler returns 500 to every
# delivery, Clerk retries for hours, then silently stops — leaving
# organizations/users rows un-provisioned. Startup-fatal as of 2026-05.
CLERK_WEBHOOK_SECRET=

# ─── Operator smoke / debug endpoints (cost-protection gate) ─────────
# Default OFF. When unset / not 'true', the backend does NOT register
# /test, /ai, /trigger-ai (each returns 404). Two of those endpoints spend
# real provider budget on every call:
#   - GET /ai          → outbound POST to OpenRouter (chat completions)
#   - GET /trigger-ai  → outbound inngest.send() (event budget)
# The third (/test) is no-cost but follows the same gate for consistency.
# Set to 'true' in .env.local for ad-hoc dev workflows; leave unset in
# production. The /health and /api/v1/health probes are always registered
# regardless of this flag (load balancers / k8s liveness depend on them).
ENABLE_SMOKE_ENDPOINTS=false

META_APP_ID=
META_APP_SECRET=

# ─── Phase 4 real-execution guards (single action: meta.pause_campaign) ───
# Default OFF. Even when ON, only orgs in META_LIVE_ORG_ALLOWLIST may trigger
# the real Meta API call (empty allowlist = all orgs allowed in dev mode).
# A real call is bracketed by `[exec] phase=exec.api_call/exec.api_response`
# log lines and always produces a decision_history row. The token is
# system-wide for now (Phase 2 will add per-org token storage).
META_PAUSE_CAMPAIGN_LIVE=false
META_DECREASE_BUDGET_LIVE=false
META_INCREASE_BUDGET_LIVE=false
# Phase 6 Sub-pass C: real-mode Meta create_campaign handler. Default OFF.
# When true + META_TEST_ACCESS_TOKEN present + org in META_LIVE_ORG_ALLOWLIST,
# pushCampaign for platform=meta calls Meta Graph API
# POST /act_{ad_account_id}/campaigns with status=PAUSED hard-coded
# (campaigns never auto-spend on creation; activation is a separate flow).
# ad_account_id resolves from ad_accounts.platform_account_id for the
# org's first connected meta integration.
META_CREATE_CAMPAIGN_LIVE=false
# Hard server-side cap on per-call budget increase (in percent). Refuses any
# `percent > META_INCREASE_BUDGET_MAX_PERCENT` BEFORE contacting Meta. Default
# 50. Lower for tighter safety; raise (with caution) only after operator review.
META_INCREASE_BUDGET_MAX_PERCENT=50
META_TEST_ACCESS_TOKEN=
META_LIVE_ORG_ALLOWLIST=
META_GRAPH_VERSION=v18.0

# ─── Phase 4 real-execution guards (single action: send_alert_email) ──────
# Default OFF. Recipients are computed server-side from `users` (org admins
# only) — caller cannot override. Placeholder emails (@placeholder.local or
# @clerk.placeholder) are filtered out before any send. Idempotency is
# enforced upstream by execution_id, so retries do NOT produce duplicate
# emails. Reuses META_LIVE_ORG_ALLOWLIST as a generic live-exec allowlist.
SEND_ALERT_EMAIL_LIVE=false
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@growthhub.local

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Continuation #112 (2026-05-14) — env documentation completeness pass
# (launch-readiness audit mode). The following Google-side vars were
# referenced in code but missing from this file, blocking a clean operator
# config of a Google-live deployment.
#
# Phase 4 Part 2: real-mode Google Ads pause_campaign handler. Default OFF.
# When true + GOOGLE_ADS_* credentials present + org in
# GOOGLE_LIVE_ORG_ALLOWLIST + per-org Vault refresh-token via integrations
# table, executes the `meta.pause_campaign` analog against Google Ads
# campaigns:mutate. Promoted to startup-fail-fast in LIVE_FLAG_DEPENDENCIES
# (backend/src/index.ts:124).
GOOGLE_PAUSE_CAMPAIGN_LIVE=false
# Generic Google live-execution allowlist (comma-separated org_ids).
# Parallel to META_LIVE_ORG_ALLOWLIST. Empty = all orgs allowed in dev
# mode. Apply to both GOOGLE_PAUSE_CAMPAIGN_LIVE and
# GOOGLE_CREATE_CAMPAIGN_LIVE.
GOOGLE_LIVE_ORG_ALLOWLIST=
# Google Ads API version pinned for outbound calls. Default v19 (the
# latest stable as of Phase 4 Part 2). Override only after confirming the
# wire-shape of campaigns:mutate / campaignBudgets:mutate hasn't changed.
GOOGLE_ADS_API_VERSION=v19
# Optional: login-customer-id header for MCC (manager account) traversal.
# Set when the connected ad_account is under an MCC; leave unset for
# direct accounts. Sent as `login-customer-id: <digits>` on every Google
# Ads API call.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Phase 6 Sub-pass C: real-mode Google Ads create_campaign handler. Default
# OFF. When true + GOOGLE_ADS_* credentials present + org in
# GOOGLE_LIVE_ORG_ALLOWLIST + per-org Vault refresh-token via integrations
# table, pushCampaign for platform=google performs TWO sequential Google
# Ads API calls: campaignBudgets:mutate (create budget) → campaigns:mutate
# (create campaign linked to budget) with status=PAUSED hard-coded.
# advertising_channel_type defaults to 'SEARCH'; override via
# params.advertising_channel_type. customer_id resolves from
# ad_accounts.platform_account_id for the org's first connected google
# integration.
GOOGLE_CREATE_CAMPAIGN_LIVE=false

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

OAUTH_REDIRECT_BASE_URL=

# Phase 7 Sub-pass A1c: Stripe webhook substrate.
#  - STRIPE_WEBHOOK_SECRET: REQUIRED at startup. HMAC-SHA256 secret used to
#    verify inbound Stripe webhook deliveries at /api/webhooks/stripe.
#    Obtain via Stripe Dashboard → Developers → Webhooks → reveal signing
#    secret. webhooks/stripe.ts performs manual HMAC verification (no
#    Stripe SDK dependency).
#  - STRIPE_SECRET_KEY: forward-positioned for a future pass that wires
#    outbound Stripe API calls (checkout sessions / customer portal /
#    subscription mutations). NOT required at startup in this pass; not
#    consumed by any route yet.
STRIPE_WEBHOOK_SECRET=
# Phase 7 Sub-pass D (continuation #21): now consumed by
# `backend/src/lib/stripe.ts` for outbound Checkout Session + Customer
# Portal API calls. Runtime-required at request time (NOT in startup-fail-
# fast list — backend boots without it; routes that call Stripe return
# `STRIPE_NOT_CONFIGURED` 500 envelope on a missing key). Populate in
# production from Stripe Dashboard → Developers → API keys → Secret key.
STRIPE_SECRET_KEY=

# Phase 7 Sub-pass D Part C: one-time credits granted to a NEW
# organization on first JIT auto-provision (authMiddleware). Fire-and-
# forget via grant_credits RPC; audit ledger row appended atomically.
# Set to 0 to disable. Default: 100 if unset.
INITIAL_ORG_CREDITS_GRANT=100

# ─── Optional operator-tunable knobs (defaults documented inline) ────
# Continuation #112 (2026-05-14) — env documentation completeness pass.
# Vars below are referenced in code but have safe defaults; left unset
# they fall through to the defaults shown. Document them here so
# operators have a single source of truth for tuning.

# Per-org execution rate limit (decision_history inserts per 60s window).
# Enforced by services/execution/action-executor.ts. Default 60. Raise
# only after reviewing downstream provider rate limits — Meta Graph
# defaults to 200 calls/hour/app, Google Ads to higher quota tiers.
ACTION_EXECUTION_MAX_PER_MINUTE=60

# OpenRouter model for /ai/decisions/generate + /ai/execute when the
# request body omits an explicit `model` field. Default
# google/gemini-2.0-flash-001. Routes to OpenRouter's model namespace;
# see https://openrouter.ai/models for the full list.
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-001

# Backend HTTP port. Default 3001 (set in backend/src/index.ts:425
# fallback). Override when running behind a reverse proxy on a different
# port. Note: .env.local.example sets NEXT_PUBLIC_BACKEND_URL to
# localhost:8000 — that's a stale FE default; sync the two values when
# changing one (BE listens on PORT here; FE fetches NEXT_PUBLIC_BACKEND_URL).
PORT=3001

# Continuation #113 (2026-05-14) — comma-separated allowlist of origins
# the backend will accept cross-origin requests from. When unset, the
# backend falls back to the dev defaults (localhost:3000 + the VPS dev
# IP) — production deploys on a custom domain MUST set this or the
# browser blocks every cross-origin fetch from the FE. Example:
#   CORS_ALLOWED_ORIGINS=https://growthhub.app,https://app.growthhub.app
CORS_ALLOWED_ORIGINS=

# Sentry DSN for backend error tracking. When set, errorHandler captures
# every 5xx with the request_id tag + sanitized stack. When unset,
# errors go to stdout only (still operator-greppable via PM2/journald).
SENTRY_DSN=

# SiliconFlow API key for image-generation creative workflow (Phase 5).
# Required for the creative generator real-mode path; when absent the
# generate endpoint returns a structured 503 with code=PROVIDER_UNAVAILABLE.
SILICONFLOW_API_KEY=

# Supabase Storage bucket for creative assets (logos, generated images).
# Default 'creatives'. Bucket must exist in the Supabase project with the
# RLS policies from supabase/migrations/20260507140000_phase5_creatives.sql.
SUPABASE_STORAGE_BUCKET=creatives